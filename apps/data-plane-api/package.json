{
  "name": "@mistle/data-plane-api",
  "private": true,
  "files": [
    "dist/**"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./src/main.ts",
      "workspace-src": "./src/main.ts",
      "node": "./dist/main.js",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "workspace-src": "./src/types.ts",
      "node": "./dist/types.js",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=workspace-src\" tsx watch --import ./src/instrument.ts src/index.ts",
    "db:migrate": "node --conditions=workspace-src --import tsx src/scripts/run-data-plane-migrations.ts",
    "workflow:migrate": "node --conditions=workspace-src --import tsx src/scripts/run-data-plane-workflow-migrations.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:property": "vitest run --passWithNoTests",
    "openapi:generate": "node --conditions=workspace-src --import tsx scripts/openapi/generate-spec.ts",
    "openapi:check": "node --conditions=workspace-src --import tsx scripts/openapi/check-spec-drift.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@hono/zod-openapi": "^1.3.0",
    "@mistle/config": "workspace:*",
    "@mistle/control-plane-internal-client": "workspace:*",
    "@mistle/db": "workspace:*",
    "@mistle/http": "workspace:*",
    "@mistle/integrations-core": "workspace:*",
    "@mistle/logging": "workspace:*",
    "@mistle/sandbox": "workspace:*",
    "@mistle/sandbox-runtime-contract": "workspace:*",
    "@mistle/telemetry": "workspace:*",
    "@mistle/time": "workspace:*",
    "@mistle/workflow-registry": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.14",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "openworkflow": "^0.9.0",
    "pg": "^8.20.0",
    "typeid-js": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mistle/data-plane-internal-client": "workspace:*",
    "@mistle/gateway-tunnel-auth": "workspace:*",
    "@mistle/test-harness": "workspace:*",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "ws": "^8.20.0"
  }
}
