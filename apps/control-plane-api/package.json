{
  "name": "@mistle/control-plane-api",
  "private": true,
  "files": [
    "dist/**"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./src/main.ts",
      "node": "./dist/main.js",
      "import": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "node": "./dist/types.js",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "tsx scripts/run-dev.ts",
    "dev:schedules": "tsx scripts/run-schedule-dispatcher-dev.ts",
    "db:migrate": "tsx scripts/run-control-plane-migrations.ts",
    "workflow:migrate": "tsx scripts/run-control-plane-workflow-migrations.ts",
    "integration-targets:sync": "tsx --tsconfig tsconfig.scripts.json scripts/run-integration-targets-sync.ts",
    "maintenance:prune-expired-auth-state": "node dist/maintenance/cli.js prune-expired-auth-state",
    "maintenance:prune-expired-integration-auth-state": "node dist/maintenance/cli.js prune-expired-integration-auth-state",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tsc -p tsconfig.build.scripts.json && tsc-alias -p tsconfig.build.scripts.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:property": "vitest run -c vitest.property.config.ts --passWithNoTests",
    "openapi:generate": "tsx --tsconfig tsconfig.scripts.json scripts/openapi/generate-spec.ts",
    "openapi:check": "tsx --tsconfig tsconfig.scripts.json scripts/openapi/check-spec-drift.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@hono/zod-openapi": "^1.3.0",
    "@mistle/config": "workspace:*",
    "@mistle/data-plane-internal-client": "workspace:*",
    "@mistle/db": "workspace:*",
    "@mistle/gateway-connection-auth": "workspace:*",
    "@mistle/http": "workspace:*",
    "@mistle/integrations-core": "workspace:*",
    "@mistle/integrations-definitions": "workspace:*",
    "@mistle/logging": "workspace:*",
    "@mistle/object-store": "workspace:*",
    "@mistle/port-access-auth": "workspace:*",
    "@mistle/sandbox": "workspace:*",
    "@mistle/sandbox-signing-auth": "workspace:*",
    "@mistle/telemetry": "workspace:*",
    "@mistle/time": "workspace:*",
    "@mistle/webhooks": "workspace:*",
    "@mistle/workflow-registry": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "better-auth": "1.5.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.14",
    "openworkflow": "^0.9.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "sharp": "0.34.5",
    "smol-toml": "^1.6.1",
    "sshpk": "^1.18.0",
    "typeid-js": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mistle/gateway-tunnel-auth": "workspace:*",
    "@mistle/test-harness": "workspace:*",
    "@types/pg": "^8.20.0",
    "@types/sshpk": "^1.17.4",
    "@types/ws": "^8.18.1",
    "ws": "^8.20.0"
  }
}
