{
  "name": "@mistle/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=workspace-src --import tsx scripts/vite-with-config.ts dev",
    "dev:e2e": "node --conditions=workspace-src --import tsx scripts/vite-with-config.ts dev --host localhost --port 4173 --strictPort",
    "build": "node --conditions=workspace-src --import tsx scripts/vite-with-config.ts build",
    "preview": "node --conditions=workspace-src --import tsx scripts/vite-with-config.ts preview",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:component": "vitest run -c vitest.component.config.ts --passWithNoTests",
    "test:bench": "vitest bench src/features/triggers/agent-instructions-performance.bench.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "openapi:generate": "tsx scripts/generate-control-plane-client.ts",
    "openapi:check": "tsx lint/check-control-plane-client-drift.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lint": "6.9.5",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.1",
    "@mistle/integrations-core": "workspace:*",
    "@mistle/integrations-definitions": "workspace:*",
    "@mistle/sandbox-lifecycle": "workspace:*",
    "@mistle/sandbox-session-client": "workspace:*",
    "@mistle/sandbox-session-protocol": "workspace:*",
    "@mistle/time": "workspace:*",
    "@mistle/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.7",
    "@pierre/diffs": "^1.1.20",
    "@posthog/react": "^1.9.0",
    "@rjsf/core": "~6.5.2",
    "@rjsf/utils": "~6.5.1",
    "@rjsf/validator-ajv8": "~6.5.1",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-pacer": "^0.22.0",
    "@tanstack/react-query": "~5.100.10",
    "@uiw/react-codemirror": "4.25.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "1.6.11",
    "dockview": "^6.0.3",
    "openapi-fetch": "^0.17.0",
    "posthog-js": "^1.373.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "~7.15.0",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@mistle/config": "workspace:*",
    "@mistle/db": "workspace:*",
    "@mistle/gateway-tunnel-auth": "workspace:*",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.20.0",
    "storybook": "^10.3.4",
    "vite": "^8.0.10",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  }
}
