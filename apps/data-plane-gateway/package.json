{
  "name": "@mistle/data-plane-gateway",
  "private": true,
  "files": [
    "dist/**"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "node": "./dist/runtime/index.js",
      "import": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "node": "./dist/types.js",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "test:integration:new": "vitest run -c vitest.integration-new.config.ts",
    "test:stress": "tsx ./scripts/run-stress-tests.ts",
    "test:property": "vitest run -c vitest.property.config.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/node-ws": "^1.3.0",
    "@mistle/config": "workspace:*",
    "@mistle/control-plane-internal-client": "workspace:*",
    "@mistle/data-plane-internal-client": "workspace:*",
    "@mistle/db": "workspace:*",
    "@mistle/gateway-connection-auth": "workspace:*",
    "@mistle/gateway-tunnel-auth": "workspace:*",
    "@mistle/logging": "workspace:*",
    "@mistle/port-access-auth": "workspace:*",
    "@mistle/sandbox-runtime-contract": "workspace:*",
    "@mistle/sandbox-session-protocol": "workspace:*",
    "@mistle/sandbox-signing-auth": "workspace:*",
    "@mistle/telemetry": "workspace:*",
    "@mistle/time": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "hono": "^4.12.14",
    "jose": "^6.1.0",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "typeid-js": "^1.2.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.0",
    "@mistle/test-harness": "workspace:*",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1"
  }
}
