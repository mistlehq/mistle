{
  "name": "@mistle/sandbox",
  "private": true,
  "files": [
    "dist/**",
    "*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "node": "./dist/*.js",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@archildata/client": "^0.8.7",
    "@mistle/time": "workspace:*",
    "dockerode": "^5.0.0",
    "e2b": "^2.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mistle/config": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "testcontainers": "^11.14.0"
  }
}
