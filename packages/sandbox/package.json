{
  "name": "@mistle/sandbox",
  "private": true,
  "files": [
    "dist/**",
    "*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workspace-src": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@mistle/time": "workspace:*",
    "@opencomputer/sdk": "0.6.2",
    "@opentelemetry/api": "^1.9.1",
    "dockerode": "^5.0.0",
    "e2b": "^2.27.0",
    "freestyle": "0.1.63",
    "modal": "0.7.6",
    "tensorlake": "0.5.47",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mistle/config": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "testcontainers": "^12.0.1",
    "vitest": "^4.1.8"
  }
}
