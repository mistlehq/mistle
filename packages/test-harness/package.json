{
  "name": "@mistle/test-harness",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": {
      "types": "./src/integration/index.ts",
      "node": "./src/integration/index.ts",
      "import": "./src/integration/index.ts",
      "default": "./src/integration/index.ts"
    },
    "./system": {
      "types": "./src/system/index.ts",
      "node": "./src/system/index.ts",
      "import": "./src/system/index.ts",
      "default": "./src/system/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "test:stress": "tsx ../../scripts/test/run-test-harness-stress.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@mistle/config": "workspace:*",
    "@mistle/db": "workspace:*",
    "@mistle/sandbox": "workspace:*",
    "@mistle/telemetry": "workspace:*",
    "@mistle/time": "workspace:*",
    "@testcontainers/postgresql": "^11.13.0",
    "mailpit-api": "^1.9.0",
    "openworkflow": "0.9.0",
    "pg": "^8.20.0",
    "postgres": "3.4.9",
    "redis": "^5.12.1",
    "testcontainers": "^11.14.0",
    "undici": "^7.24.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
