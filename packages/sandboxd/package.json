{
  "name": "@mistle/sandboxd",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && cargo build --locked --bin sandboxd && mkdir -p dist && cp target/debug/sandboxd dist/sandboxd",
    "build:go": "go test ./... -run '^$'",
    "lint": "cargo clippy --locked --all-targets -- -D warnings",
    "lint:go": "go vet ./...",
    "typecheck": "cargo check --locked --all-targets",
    "typecheck:go": "go test ./... -run '^$'",
    "test": "node ./scripts/run-cargo-in-container.mjs nextest run --locked --lib --bins",
    "test:go": "go test ./...",
    "test:integration": "node ./scripts/run-cargo-integration-tests-in-container.mjs",
    "test:stress": "node ./scripts/run-cargo-stress-tests-in-container.mjs",
    "format": "node ./scripts/cargo-fmt.mjs && gofmt -w .",
    "format:check": "node ./scripts/cargo-fmt.mjs --check && test -z \"$(gofmt -l .)\""
  }
}
