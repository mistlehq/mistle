ARG NODE_IMAGE=node:24.14.1-bookworm

FROM ${NODE_IMAGE} AS node

FROM rust:1.93-bookworm

ARG CODEX_CLI_VERSION=0.129.0
ARG MISE_VERSION=v2026.4.19
ARG CARGO_NEXTEST_VERSION=0.9.133

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    libssl-dev \
    pkg-config \
  && rm -rf /var/lib/apt/lists/*

RUN cargo install --locked cargo-nextest --version ${CARGO_NEXTEST_VERSION}
RUN curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise MISE_VERSION=${MISE_VERSION} sh
RUN npm install -g @openai/codex@${CODEX_CLI_VERSION}
