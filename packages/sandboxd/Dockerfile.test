ARG NODE_IMAGE=node:24.14.1-bookworm

FROM ${NODE_IMAGE} AS node

FROM rust:1.93-bookworm

ARG CODEX_CLI_VERSION=0.131.0
ARG OPENCODE_CLI_VERSION=1.14.48
ARG TARGETARCH
ARG MISE_VERSION=v2026.4.19
ARG CARGO_NEXTEST_VERSION=0.9.133

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    libssl-dev \
    pkg-config \
  && rm -rf /var/lib/apt/lists/*

RUN cargo install --locked cargo-nextest --version ${CARGO_NEXTEST_VERSION}
RUN curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise MISE_VERSION=${MISE_VERSION} sh
RUN npm install -g @openai/codex@${CODEX_CLI_VERSION}
RUN case "${TARGETARCH}" in \
    amd64) opencode_asset="opencode-linux-x64-baseline.tar.gz" ;; \
    arm64) opencode_asset="opencode-linux-arm64.tar.gz" ;; \
    *) echo "Unsupported OpenCode CLI architecture: ${TARGETARCH}" >&2; exit 1 ;; \
  esac \
  && curl -fsSL "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_CLI_VERSION}/${opencode_asset}" \
    | tar -xz -C /usr/local/bin opencode \
  && chmod 755 /usr/local/bin/opencode
