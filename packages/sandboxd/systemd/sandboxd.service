[Unit]
Description=Mistle sandbox daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/opt/mistle/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
PassEnvironment=SANDBOX_RUNTIME_LISTEN_ADDR SANDBOX_RUNTIME_SANDBOX_INSTANCE_ID MISTLE_SANDBOXD_ENABLE_TEST_FAULTS MISTLE_SANDBOXD_OPERATION_LOG_DIR
ExecStart=/opt/mistle/bin/sandboxd
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
