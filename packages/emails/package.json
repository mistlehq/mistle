{
  "name": "@mistle/emails",
  "private": true,
  "files": [
    "dist/**",
    "*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workspace-src": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "workspace-src": "./src/testing/index.ts",
      "node": "./dist/testing/index.js",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "preview": "email preview ./preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@jsx-email/plugin-inline": "^2.0.0",
    "@jsx-email/plugin-minify": "^2.0.0",
    "@jsx-email/plugin-pretty": "^2.0.0",
    "jsx-email": "^3.2.0",
    "nodemailer": "^8.0.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@mistle/test-harness": "workspace:*",
    "@types/nodemailer": "^8.0.0",
    "zod": "^4.4.3"
  }
}
