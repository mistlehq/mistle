{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mistle Docs",
  "colors": {
    "primary": "#0D5F2E",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "description": "Mistle is open source software for configuring engineering agents and their execution environments. Teams use it to delegate work like improving test coverage, implementing analytics, handling on-call triage, and building well-scoped features.",
  "favicon": "/favicon.ico",
  "icons": {
    "library": "fontawesome"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "guides/integrations",
              "guides/account-linking",
              "guides/sandbox-profiles",
              "guides/snapshots",
              "guides/sessions",
              "guides/triggers"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "guides/aws-integration-setup",
              "guides/anthropic-integration-setup",
              "guides/datadog-integration-setup",
              "guides/gcp-integration-setup",
              "guides/github-integration-setup",
              "guides/jira-integration-setup",
              "guides/linear-integration-setup",
              "guides/opencode-go-integration-setup",
              "guides/openai-integration-setup",
              "guides/planetscale-integration-setup",
              "guides/signoz-integration-setup",
              "guides/slack-integration-setup"
            ]
          }
        ]
      },
      {
        "tab": "Self-Hosting",
        "hidden": true,
        "groups": [
          {
            "group": "Quickstart",
            "pages": ["guides/self-hosted-docker-compose-quickstart"]
          },
          {
            "group": "Integrations",
            "pages": [
              "guides/self-hosted-integrations-overview",
              "guides/self-hosted-integration-targets",
              "guides/self-hosted-webhook-callbacks"
            ]
          },
          {
            "group": "Configuration Reference",
            "pages": ["guides/self-hosted-configuration"]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://mistle.dev"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/mistlehq/mistle"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/mistlehq/mistle",
      "x": "https://x.com/mistledev",
      "linkedin": "https://www.linkedin.com/company/mistlehq"
    }
  }
