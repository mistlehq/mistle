{
  "name": "@mistle/integrations-core",
  "private": true,
  "files": [
    "dist/**",
    "*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workspace-src": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./triggers": {
      "types": "./src/triggers.ts",
      "workspace-src": "./src/triggers.ts",
      "node": "./dist/triggers.js",
      "import": "./dist/triggers.js",
      "default": "./dist/triggers.js"
    },
    "./triggers.js": {
      "types": "./src/triggers.ts",
      "workspace-src": "./src/triggers.ts",
      "node": "./dist/triggers.js",
      "import": "./dist/triggers.js",
      "default": "./dist/triggers.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@mistle/config": "workspace:*",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  }
}
