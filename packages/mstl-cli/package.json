{
  "name": "@mistle/mstl-cli",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && go build -o dist/mistle ./cmd/mistle",
    "lint": "go vet ./...",
    "typecheck": "go test ./... -run '^$'",
    "test": "go test ./...",
    "format": "gofmt -w .",
    "format:check": "test -z \"$(gofmt -l .)\""
  }
}
