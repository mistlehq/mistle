{
  "name": "@mistle/db",
  "private": true,
  "files": [
    "dist/**",
    "*.js",
    "migrations/**"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workspace-src": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./control-plane": {
      "types": "./src/control-plane/index.ts",
      "workspace-src": "./src/control-plane/index.ts",
      "node": "./dist/control-plane/index.js",
      "import": "./dist/control-plane/index.js",
      "default": "./dist/control-plane/index.js"
    },
    "./data-plane": {
      "types": "./src/data-plane/index.ts",
      "workspace-src": "./src/data-plane/index.ts",
      "node": "./dist/data-plane/index.js",
      "import": "./dist/data-plane/index.js",
      "default": "./dist/data-plane/index.js"
    },
    "./migrator": {
      "types": "./src/migrator/index.ts",
      "workspace-src": "./src/migrator/index.ts",
      "node": "./dist/migrator/index.js",
      "import": "./dist/migrator/index.js",
      "default": "./dist/migrator/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "workspace-src": "./src/testing/index.ts",
      "node": "./dist/testing/index.js",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./test-environment": {
      "types": "./src/test-environment.ts",
      "workspace-src": "./src/test-environment.ts",
      "node": "./dist/test-environment.js",
      "import": "./dist/test-environment.js",
      "default": "./dist/test-environment.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:sql": "squawk --config ./.squawk.toml --no-error-on-unmatched-pattern \"migrations/control-plane/**/*.sql\" \"migrations/data-plane/**/*.sql\"",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@mistle/sandbox-lifecycle": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "typeid-js": "^1.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "squawk-cli": "^2.46.0",
    "zod": "^4.4.3"
  }
}
