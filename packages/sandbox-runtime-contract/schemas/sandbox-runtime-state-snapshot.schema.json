{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ownerLeaseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attachment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sandboxInstanceId": {
              "type": "string",
              "minLength": 1
            },
            "ownerLeaseId": {
              "type": "string",
              "minLength": 1
            },
            "nodeId": {
              "type": "string",
              "minLength": 1
            },
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "attachedAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["sandboxInstanceId", "ownerLeaseId", "nodeId", "sessionId", "attachedAtMs"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "presence": {
      "type": "object",
      "properties": {
        "activeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["activeCount"],
      "additionalProperties": false
    },
    "keepalive": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        }
      },
      "required": ["active"],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "ready": {
          "type": "boolean"
        }
      },
      "required": ["ready"],
      "additionalProperties": false
    }
  },
  "required": ["ownerLeaseId", "attachment", "presence", "keepalive", "runtime"],
  "additionalProperties": false
}
