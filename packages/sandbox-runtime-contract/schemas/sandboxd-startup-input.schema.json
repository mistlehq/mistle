{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "startupMode": {
      "type": "string",
      "enum": ["new", "existing"]
    },
    "bootstrapToken": {
      "type": "string",
      "minLength": 1
    },
    "tunnelExchangeToken": {
      "type": "string",
      "minLength": 1
    },
    "tunnelGatewayWsUrl": {
      "type": "string",
      "minLength": 1
    },
    "runtimePlan": {
      "type": "object",
      "properties": {
        "sandboxProfileId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "image": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "profile-base"
                },
                "imageRef": {
                  "type": "string",
                  "minLength": 1
                },
                "sandboxProfileId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": ["source", "imageRef", "sandboxProfileId", "version"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "base"
                },
                "imageRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["source", "imageRef"],
              "additionalProperties": false
            }
          ]
        },
        "egressRoutes": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "egressRuleId": {
                "type": "string",
                "minLength": 1
              },
              "bindingId": {
                "type": "string",
                "minLength": 1
              },
              "match": {
                "type": "object",
                "properties": {
                  "hosts": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "pathPrefixes": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "methods": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["hosts"],
                "additionalProperties": false
              },
              "upstream": {
                "type": "object",
                "properties": {
                  "baseUrl": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["baseUrl"],
                "additionalProperties": false
              },
              "authInjection": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "bearer"
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["type", "target"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "basic"
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      },
                      "username": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["type", "target"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "header"
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["type", "target"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "query"
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["type", "target"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "aws_sigv4"
                      },
                      "service": {
                        "type": "string",
                        "minLength": 1
                      },
                      "region": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["type", "service", "region"],
                    "additionalProperties": false
                  }
                ]
              },
              "additionalHeaders": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "credentialResolver": {
                "type": "object",
                "properties": {
                  "connectionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "secretType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slotKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resolverKey": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["connectionId", "secretType"],
                "additionalProperties": false
              }
            },
            "required": [
              "egressRuleId",
              "bindingId",
              "match",
              "upstream",
              "authInjection",
              "credentialResolver"
            ],
            "additionalProperties": false
          }
        },
        "artifacts": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactKey": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "lifecycle": {
                "type": "object",
                "properties": {
                  "install": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "args": {
                          "readOnly": true,
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "env": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "cwd": {
                          "type": "string",
                          "minLength": 1
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["args"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["install"],
                "additionalProperties": false
              }
            },
            "required": ["artifactKey", "name", "lifecycle"],
            "additionalProperties": false
          }
        },
        "workspaceSources": {
          "readOnly": true,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "sourceKind": {
                    "type": "string",
                    "const": "git-clone"
                  },
                  "resourceKind": {
                    "type": "string",
                    "const": "repository"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "originUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["sourceKind", "resourceKind", "path", "originUrl"],
                "additionalProperties": false
              }
            ]
          }
        },
        "runtimeClients": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "setup": {
                "type": "object",
                "properties": {
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "files": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fileId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "mode": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "content": {
                          "type": "string"
                        },
                        "writeMode": {
                          "type": "string",
                          "enum": ["overwrite", "if-absent"]
                        }
                      },
                      "required": ["fileId", "path", "mode", "content"],
                      "additionalProperties": false
                    }
                  },
                  "launchArgs": {
                    "readOnly": true,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["env", "files"],
                "additionalProperties": false
              },
              "processes": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "processKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command": {
                      "type": "object",
                      "properties": {
                        "args": {
                          "readOnly": true,
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "env": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "cwd": {
                          "type": "string",
                          "minLength": 1
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["args"],
                      "additionalProperties": false
                    },
                    "readiness": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "none"
                            }
                          },
                          "required": ["type"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "tcp"
                            },
                            "host": {
                              "type": "string",
                              "minLength": 1
                            },
                            "port": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65535
                            },
                            "timeoutMs": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["type", "host", "port", "timeoutMs"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "http"
                            },
                            "url": {
                              "type": "string",
                              "format": "uri"
                            },
                            "expectedStatus": {
                              "type": "integer",
                              "minimum": 100,
                              "maximum": 599
                            },
                            "timeoutMs": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["type", "url", "expectedStatus", "timeoutMs"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "ws"
                            },
                            "url": {
                              "type": "string",
                              "format": "uri"
                            },
                            "timeoutMs": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": ["type", "url", "timeoutMs"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "stop": {
                      "type": "object",
                      "properties": {
                        "signal": {
                          "type": "string",
                          "enum": ["sigterm", "sigkill"]
                        },
                        "timeoutMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "gracePeriodMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["signal", "timeoutMs"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["processKey", "command", "readiness", "stop"],
                  "additionalProperties": false
                }
              },
              "endpoints": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "endpointKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "processKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "transport": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "ws"
                            },
                            "url": {
                              "type": "string",
                              "format": "uri"
                            }
                          },
                          "required": ["type", "url"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "connectionMode": {
                      "type": "string",
                      "enum": ["dedicated", "shared"]
                    }
                  },
                  "required": ["endpointKey", "transport", "connectionMode"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["clientId", "setup", "processes", "endpoints"],
            "additionalProperties": false
          }
        },
        "agentRuntimes": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1
              },
              "runtimeId": {
                "type": "string",
                "minLength": 1
              },
              "runtimeKey": {
                "type": "string",
                "minLength": 1
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "endpointKey": {
                "type": "string",
                "minLength": 1
              },
              "ptyLaunch": {
                "type": "object",
                "properties": {
                  "runtimeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "newLaunch": {
                    "type": "object",
                    "properties": {
                      "ptySessionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cols": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "rows": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "cwd": {
                        "type": "string",
                        "minLength": 1
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "readOnly": true,
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "literal"
                                },
                                "value": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": ["kind", "value"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "threadId"
                                }
                              },
                              "required": ["kind"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": ["ptySessionId", "cols", "rows", "command", "args"],
                    "additionalProperties": false
                  },
                  "resumeLaunch": {
                    "type": "object",
                    "properties": {
                      "ptySessionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cols": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "rows": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "cwd": {
                        "type": "string",
                        "minLength": 1
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "readOnly": true,
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "literal"
                                },
                                "value": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": ["kind", "value"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "threadId"
                                }
                              },
                              "required": ["kind"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": ["ptySessionId", "cols", "rows", "command", "args"],
                    "additionalProperties": false
                  }
                },
                "required": ["runtimeId", "displayName", "newLaunch", "resumeLaunch"],
                "additionalProperties": false
              }
            },
            "required": [
              "bindingId",
              "runtimeId",
              "runtimeKey",
              "clientId",
              "endpointKey",
              "ptyLaunch"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sandboxProfileId",
        "version",
        "image",
        "egressRoutes",
        "artifacts",
        "workspaceSources",
        "runtimeClients",
        "agentRuntimes"
      ],
      "additionalProperties": false
    },
    "egressGrantByRuleId": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "startupMode",
    "bootstrapToken",
    "tunnelExchangeToken",
    "tunnelGatewayWsUrl",
    "runtimePlan",
    "egressGrantByRuleId"
  ],
  "additionalProperties": false
}
