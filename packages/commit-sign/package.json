{
  "name": "@mistle/commit-sign",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && go build -o dist/commit-sign ./cmd/commit-sign",
    "lint": "go vet ./...",
    "typecheck": "go test ./... -run '^$'",
    "test": "go test ./...",
    "format": "gofmt -w .",
    "format:check": "test -z \"$(gofmt -l .)\""
  }
}
