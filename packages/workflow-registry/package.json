{
  "name": "@mistle/workflow-registry",
  "private": true,
  "files": [
    "dist/**",
    "*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workspace-src": "./src/index.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./control-plane": {
      "types": "./src/control-plane.ts",
      "workspace-src": "./src/control-plane.ts",
      "node": "./dist/control-plane.js",
      "import": "./dist/control-plane.js",
      "default": "./dist/control-plane.js"
    },
    "./data-plane": {
      "types": "./src/data-plane.ts",
      "workspace-src": "./src/data-plane.ts",
      "node": "./dist/data-plane.js",
      "import": "./dist/data-plane.js",
      "default": "./dist/data-plane.js"
    },
    "./durable-step-retry.js": {
      "types": "./src/durable-step-retry.ts",
      "workspace-src": "./src/durable-step-retry.ts",
      "node": "./dist/durable-step-retry.js",
      "import": "./dist/durable-step-retry.js",
      "default": "./dist/durable-step-retry.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@mistle/db": "workspace:*",
    "@mistle/integrations-core": "workspace:*",
    "@mistle/sandbox": "workspace:*",
    "openworkflow": "^0.9.0"
  }
}
