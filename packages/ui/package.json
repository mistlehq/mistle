{
  "name": "@mistle/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./test-support/responsive-breakpoints.js": {
      "types": "./src/test-support/responsive-breakpoints.ts",
      "node": "./src/test-support/responsive-breakpoints.ts",
      "import": "./src/test-support/responsive-breakpoints.ts",
      "default": "./src/test-support/responsive-breakpoints.ts"
    },
    "./*.js": {
      "types": "./src/*",
      "workspace-src": "./src/*",
      "node": "./dist/*.js",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/quicksand": "^5.2.10",
    "@mistle/time": "workspace:*",
    "@phosphor-icons/react": "^2.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
