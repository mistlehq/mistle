  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts --passWithNoTests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@aws-sdk/client-sts": "3.1047.0",
    "@mistle/http": "workspace:*",
    "@mistle/integrations-core": "workspace:*",
    "@mistle/sandbox-session-client": "workspace:*",
    "@mistle/time": "workspace:*",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/request": "^10.0.8",
    "@octokit/webhooks-methods": "^6.0.0",
    "@opencode-ai/sdk": "1.15.10",
    "@opentelemetry/api": "^1.9.0",
    "octokit": "^5.0.5",
