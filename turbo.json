{
  "$schema": "https://turbo.build/schema.json",
  "noUpdateNotifier": true,
  "globalPassThroughEnv": [
    "AR",
    "CC",
    "CXX",
    "DEVELOPER_DIR",
    "HOST_PATH",
    "LD",
    "MACOSX_DEPLOYMENT_TARGET",
    "NIX_*",
    "NM",
    "RANLIB",
    "SDKROOT",
    "MISTLE_CONFIG_PATH",
    "MISTLE_TELEMETRY_ENABLED",
    "MISTLE_TELEMETRY_DEBUG",
    "MISTLE_TELEMETRY_TRACES_ENDPOINT",
    "MISTLE_TELEMETRY_LOGS_ENDPOINT",
    "MISTLE_TELEMETRY_METRICS_ENDPOINT",
    "MISTLE_TELEMETRY_RESOURCE_ATTRIBUTES"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["MISTLE_*"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "dev:schedules": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["MISTLE_*"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "^typecheck"],
      "passThroughEnv": ["MISTLE_*"],
      "outputs": []
    },
    "test:component": {
      "dependsOn": ["^build", "^typecheck"],
      "passThroughEnv": ["MISTLE_*"],
      "outputs": []
    },
    "test:property": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["MISTLE_*"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["MISTLE_*"],
      "outputs": []
    }
  }
}
