# Shared deployment contract reference.
# Local uses deploy/compose/local/.env for actual values.

MISTLE_COMPOSE_PROJECT_NAME=mistle-local
MISTLE_GLOBAL_INTERNAL_AUTH_SERVICE_TOKEN=replace-with-internal-service-token
MISTLE_GLOBAL_SANDBOX_DEFAULT_BASE_IMAGE=ghcr.io/mistlehq/sandbox-base:latest
MISTLE_GLOBAL_SANDBOX_GATEWAY_WS_URL=ws://localhost:8084/tunnel/sandbox
MISTLE_GLOBAL_SANDBOX_INTERNAL_GATEWAY_WS_URL=ws://data-plane-gateway:5202/tunnel/sandbox
MISTLE_GLOBAL_SANDBOX_STORAGE_BACKEND=docker_volume
MISTLE_GLOBAL_SANDBOX_CONNECT_TOKEN_SECRET=replace-with-connect-token-secret
MISTLE_GLOBAL_SANDBOX_BOOTSTRAP_TOKEN_SECRET=replace-with-bootstrap-token-secret
MISTLE_GLOBAL_SANDBOX_EGRESS_TOKEN_SECRET=replace-with-egress-token-secret
MISTLE_GLOBAL_SANDBOX_PUBLISH_ACCESS_TOKEN_SECRET=replace-with-publish-access-token-secret
MISTLE_GLOBAL_SANDBOX_PUBLISH_SESSION_COOKIE_SIGNING_SECRET=replace-with-publish-session-cookie-signing-secret
MISTLE_APPS_CONTROL_PLANE_API_AUTH_BASE_URL=http://localhost:8080
MISTLE_APPS_CONTROL_PLANE_API_AUTH_SECRET=replace-with-auth-secret
MISTLE_APPS_CONTROL_PLANE_API_INTEGRATIONS_ACTIVE_MASTER_ENCRYPTION_KEY_VERSION=1
MISTLE_APPS_CONTROL_PLANE_API_INTEGRATIONS_MASTER_ENCRYPTION_KEYS_JSON={"1":"replace-with-master-encryption-key"}
MISTLE_DASHBOARD_CONTROL_PLANE_API_ORIGIN=http://localhost:8080
MISTLE_DASHBOARD_AUTH_METHOD_GOOGLE=false
MISTLE_SANDBOX_NETWORK_NAME=mistle-sandbox-local
MISTLE_SANDBOX_STORAGE_DOCKER_VOLUME_NAME_PREFIX=mistle-local-
