MISTLE_COMPOSE_PROJECT_NAME=mistle-local

# Local Compose pulls these published images directly.
MISTLE_DOCKER_IMAGE=ghcr.io/mistlehq/mistle:docker-latest
MISTLE_SANDBOX_DEFAULT_BASE_IMAGE=ghcr.io/mistlehq/sandbox-base:latest

# Local URLs use the same host and container ports exposed by docker/Dockerfile.single.
MISTLE_ENV=development
MISTLE_SERVICES_DASHBOARD_PUBLIC_URL=http://localhost:3000
MISTLE_SERVICES_CONTROL_PLANE_API_PUBLIC_URL=
MISTLE_SERVICES_CONTROL_PLANE_API_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MISTLE_SERVICES_DATA_PLANE_GATEWAY_SANDBOX_WS_PUBLIC_URL=ws://localhost:5202/tunnel/sandbox
MISTLE_SERVICES_TOKENIZER_PROXY_PUBLIC_URL=http://localhost:5205
MISTLE_SERVICES_CONTROL_PLANE_WORKER_WORKFLOW_CONCURRENCY=4
MISTLE_SERVICES_DATA_PLANE_WORKER_WORKFLOW_CONCURRENCY=4
MISTLE_WORKFLOW_CONTROL_PLANE_NAMESPACE_ID=local
MISTLE_WORKFLOW_DATA_PLANE_NAMESPACE_ID=local

# Docker-backed local sandbox/runtime wiring.
MISTLE_SANDBOX_NETWORK_NAME=mistle-sandbox-local
MISTLE_SANDBOX_STORAGE_BACKEND=docker_volume
MISTLE_SERVICES_DATA_PLANE_GATEWAY_SANDBOX_WS_INTERNAL_URL=ws://mistle:5202/tunnel/sandbox
MISTLE_SERVICES_TOKENIZER_PROXY_EGRESS_URL=http://mistle:5205/tokenizer-proxy/egress
MISTLE_SANDBOX_DOCKER_NETWORK_NAME=mistle-sandbox-local
MISTLE_SANDBOX_STORAGE_DOCKER_VOLUME_NAME_PREFIX=mistle-local-
MISTLE_SANDBOX_PUBLISH_BASE_DOMAIN=mistle.localhost

# Local infrastructure. Most users do not need to edit these values.
MISTLE_POSTGRES_CONTROL_PLANE_DIRECT_URL=postgresql://mistle:mistle@postgres:5432/mistle_local
MISTLE_POSTGRES_CONTROL_PLANE_POOLED_URL=postgresql://mistle:mistle@postgres:5432/mistle_local
MISTLE_POSTGRES_DATA_PLANE_DIRECT_URL=postgresql://mistle:mistle@postgres:5432/mistle_local
MISTLE_POSTGRES_DATA_PLANE_POOLED_URL=postgresql://mistle:mistle@postgres:5432/mistle_local
MISTLE_KV_DATA_PLANE_URL=redis://valkey:6379
MISTLE_OBJECT_STORE_ASSETS_BUCKET_NAME=mistle-assets
MISTLE_OBJECT_STORE_ASSETS_REGION=us-east-1
MISTLE_OBJECT_STORE_ASSETS_ENDPOINT=http://seaweedfs:8333
MISTLE_OBJECT_STORE_ASSETS_ACCESS_KEY_ID=mistle-access-key
MISTLE_OBJECT_STORE_ASSETS_SECRET_ACCESS_KEY=mistle-secret-key
MISTLE_EMAIL_SMTP_FROM_ADDRESS=no-reply@mistle.local
MISTLE_EMAIL_SMTP_FROM_NAME=Mistle
MISTLE_EMAIL_SMTP_HOST=mailpit
MISTLE_EMAIL_SMTP_PORT=1025
MISTLE_EMAIL_SMTP_SECURE=false
MISTLE_EMAIL_SMTP_USERNAME=mailpit
MISTLE_EMAIL_SMTP_PASSWORD=mailpit

# Leave MISTLE_SERVICES_CONTROL_PLANE_API_PUBLIC_URL blank for the default quick-tunnel flow.
# ./up.sh injects a generated public webhook URL for this run only.
# Set it explicitly only when you want to override the quick tunnel with a stable public URL.
