# Copy this file to .env.test for local test secrets and opt-in test toggles.
# Do not commit .env.test.
# Generated integration/system test runtime context is written to .local/test-context/*.json.

# Real API key for Codex-backed integration/system tests.
MISTLE_TEST_OPENAI_API_KEY=

# GitHub token with access to the test repository and installation.
MISTLE_TEST_GITHUB_TOKEN=

# Repository used by GitHub-related system tests, in owner/repo format.
MISTLE_TEST_GITHUB_TEST_REPOSITORY=
MISTLE_TEST_GITHUB_APP_CLIENT_ID=
MISTLE_TEST_GITHUB_APP_CLIENT_SECRET=

# Optional: @mistle/sandbox integration tests.
# Set to 1 to enable sandbox package integration tests.
MISTLE_TEST_SANDBOX_INTEGRATION=

# Comma-separated providers to run (for example: docker,e2b).
MISTLE_TEST_SANDBOX_INTEGRATION_PROVIDERS=

# Optional: override the Docker socket path for docker provider integration tests.
# Defaults to /var/run/docker.sock when unset.
MISTLE_SANDBOX_DOCKER_SOCKET_PATH=

# Required for e2b sandbox integration tests when e2b is enabled above.
E2B_API_KEY=

# Required for E2B-backed runtime system tests. In CI, inject this from Infisical.
MISTLE_SANDBOX_E2B_API_KEY=

# Optional: override the E2B domain used in e2b sandbox tests.
MISTLE_SANDBOX_E2B_DOMAIN=

# Required for system tests that need public access to local runtime services.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS_JSON=
DATA_PLANE_API_TUNNEL_HOSTNAME=
TOKENIZER_PROXY_TUNNEL_HOSTNAME=

# Required for GitHub webhook-backed system tests.
CONTROL_PLANE_API_TUNNEL_HOSTNAME=
MISTLE_TEST_GITHUB_APP_ID=
MISTLE_TEST_GITHUB_APP_SLUG=
MISTLE_TEST_GITHUB_APP_PRIVATE_KEY_PEM=
MISTLE_TEST_GITHUB_WEBHOOK_SECRET=

# Required for Archil-backed persistent system tests and integration-config generation.
MISTLE_TEST_ARCHIL_API_KEY=
MISTLE_TEST_ARCHIL_S3_BUCKET=
MISTLE_TEST_ARCHIL_S3_ENDPOINT=
MISTLE_TEST_ARCHIL_S3_ACCESS_KEY_ID=
MISTLE_TEST_ARCHIL_S3_SECRET_ACCESS_KEY=
