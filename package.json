{
  "name": "mistle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ./scripts/dev/start.ts",
    "dev:nix": "nix develop --command pnpm dev",
    "dev:workspace": "turbo watch dev dev:schedules --ui=tui --filter=!@mistle/docs --env-mode=loose",
    "docs:dev": "nix develop .#docs -c pnpm --filter @mistle/docs dev",
    "compose:local:smoke-test": "tsx ./deploy/compose/scripts/smoke-test-local.ts",
    "storybook": "pnpm --filter @mistle/storybook storybook",
    "storybook:build": "pnpm --filter @mistle/storybook build-storybook",
    "emails:preview": "pnpm --filter @mistle/emails preview",
    "dev:down": "tsx ./scripts/dev/down.ts",
    "dev:reset": "tsx ./scripts/dev/down.ts --volumes",
    "dev:reset:hard": "tsx ./scripts/dev/down.ts --volumes --rmi-local",
    "build": "turbo run build",
    "build:ts": "turbo run build --filter=!@mistle/sandboxd --filter=!@mistle/commit-sign",
    "format": "oxfmt . && pnpm --filter @mistle/sandboxd format && pnpm --filter @mistle/commit-sign format",
    "format:check": "oxfmt --check . && pnpm --filter @mistle/sandboxd format:check && pnpm --filter @mistle/commit-sign format:check",
    "validate:changed": "tsx ./scripts/dev/validate-changed.ts",
    "lint": "pnpm lint:ts && pnpm lint:rust",
    "lint:workspace": "pnpm lint:oxlint",
    "lint:ts": "pnpm lint:oxlint && pnpm lint:openapi && pnpm lint:docs",
    "lint:oxlint": "oxlint --type-aware --deny-warnings apps packages tests",
    "lint:extra": "pnpm lint:openapi && pnpm lint:docs && pnpm lint:rust",
    "lint:openapi": "pnpm --filter @mistle/control-plane-api openapi:check && pnpm --filter @mistle/data-plane-api openapi:check && pnpm --filter @mistle/control-plane-internal-client openapi:check && pnpm --filter @mistle/data-plane-internal-client openapi:check",
    "lint:docs": "pnpm --filter @mistle/docs lint",
    "lint:rust": "pnpm --filter @mistle/sandboxd lint && pnpm --filter @mistle/commit-sign lint",
    "lint:spelling": "typos .",
    "lint:knip": "knip --config knip.jsonc --no-progress --reporter compact",
    "lint:knip:report": "knip --config knip.jsonc --no-progress --reporter compact --no-exit-code",
    "lint:sql": "pnpm --filter @mistle/db lint:sql",
    "lint-staged": "lint-staged",
    "config:init:dev": "tsx ./scripts/config/init-development.ts",
    "config:init:integration": "tsx ./scripts/config/init-integration.ts",
    "typecheck": "pnpm typecheck:workspace && pnpm typecheck:scripts",
    "typecheck:workspace": "turbo run typecheck --output-logs=errors-only",
    "typecheck:ts": "turbo run typecheck --output-logs=errors-only --filter=!@mistle/sandboxd --filter=!@mistle/commit-sign && pnpm typecheck:scripts",
    "typecheck:rust": "turbo run typecheck --output-logs=errors-only --filter=@mistle/sandboxd --filter=@mistle/commit-sign",
    "typecheck:scripts": "tsc --project ./scripts/tsconfig.json",
    "test": "pnpm test:workspace && pnpm test:component",
    "test:workspace": "turbo run test --output-logs=errors-only",
    "test:component": "turbo run test:component --output-logs=errors-only",
    "test:ts": "turbo run test --output-logs=errors-only --filter=!@mistle/sandboxd --filter=!@mistle/commit-sign && pnpm test:component",
    "test:rust": "pnpm --filter @mistle/commit-sign test && pnpm --filter @mistle/sandboxd test && pnpm --filter @mistle/sandboxd test:integration",
    "test:property": "turbo run test:property",
    "test-harness:prepare-runtime": "tsx ./scripts/test/prepare-test-harness-runtime.ts",
    "test:integration": "tsx ./scripts/test/run-integration-vitest.ts",
    "test:integration:new": "tsx ./scripts/test/run-integration-new-vitest.ts",
    "test:integration:rust": "pnpm --filter @mistle/sandboxd test:integration",
    "test:integration:all": "pnpm test:integration && pnpm test:integration:rust",
    "sandbox-base:inventory:update": "pnpm sandbox-base:inventory:check-spec && tsx ./scripts/sandbox-base/generate-inventory.ts --write",
    "sandbox-base:inventory:check": "pnpm sandbox-base:inventory:check-spec && tsx ./scripts/sandbox-base/generate-inventory.ts --check",
    "sandbox-base:inventory:check-spec": "tsx ./scripts/sandbox-base/check-inventory-spec.ts",
    "test:sandbox-base:linux": "docker build --platform ${MISTLE_SANDBOX_BASE_CHECK_PLATFORM:-linux/amd64} --target sandbox-base -t mistle-sandbox-base-check:local -f packages/sandboxd/Dockerfile .",
    "test:system": "pnpm --filter @mistle/tests test:system",
    "test:system:docker": "pnpm --filter @mistle/tests test:system:docker",
    "test:system:e2b": "pnpm --filter @mistle/tests test:system:e2b",
    "test:system:all": "pnpm --filter @mistle/tests test:system:all",
    "test:e2e": "pnpm --filter @mistle/tests test:e2e",
    "release:start": "tsx ./scripts/release/start.ts",
    "release:prepare": "tsx ./scripts/release/prepare.ts",
    "release:validate-tag": "tsx ./scripts/release/validate-tag.ts",
    "release:notes": "tsx ./scripts/release/notes.ts",
    "release:write-notes": "tsx ./scripts/release/write-notes.ts",
    "release:create-tag": "tsx ./scripts/release/create-tag.ts",
    "ci:ts": "pnpm format:check && pnpm lint:ts && pnpm lint:sql && pnpm typecheck:ts && pnpm build:ts && pnpm test:ts",
    "ci:rust": "pnpm lint:rust && pnpm typecheck:rust && pnpm test:rust",
    "ci": "pnpm ci:ts && pnpm ci:rust",
    "ci:nix": "nix develop --command pnpm run ci",
    "prepare": "node -e \"const cp = require('child_process'); if (!(process.env.CI || process.env.LEFTHOOK === '0')) { try { cp.execSync('git rev-parse --is-inside-work-tree', { stdio: 'ignore' }); cp.execSync('lefthook install', { stdio: 'inherit' }); } catch {} }\""
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@mistle/test-harness": "workspace:*",
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/native-preview": "latest",
    "knip": "^5.88.0",
    "lefthook": "^2.1.6",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "smol-toml": "^1.6.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^25.0.0",
    "pnpm": "10.30.2"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "axios": "1.15.0",
      "@aws-sdk/xml-builder": "3.972.19",
      "dockerode>protobufjs": "7.5.5",
      "mermaid>dompurify": "3.4.0"
    }
  }
}
