{
  "name": "mistle",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:ts": "turbo run build --filter=!@mistle/sandboxd --filter=!@mistle/commit-sign --filter=!@mistle/mstl-core --filter=!@mistle/mstl-cli",
    "check:fast": "pnpm typecheck && pnpm lint:fast && TURBO_SCM_BASE=origin/main TURBO_SCM_HEAD=HEAD pnpm exec turbo run test test:component --affected --output-logs=errors-only",
    "ci": "pnpm ci:ts && pnpm ci:rust",
    "ci:rust": "pnpm lint:rust && pnpm typecheck:rust && pnpm test:rust",
    "ci:ts": "pnpm format:check && pnpm lint:ts && pnpm lint:sql && pnpm typecheck:ts && pnpm build:ts && pnpm test:ts",
    "compose:local:smoke-test": "tsx ./deploy/compose/scripts/smoke-test-local.ts",
    "config:init:dev": "tsx ./scripts/config/init-development.ts",
    "config:init:integration": "tsx ./scripts/config/init-integration.ts",
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=workspace-src\" tsx ./scripts/dev/start.ts",
    "dev:down": "tsx ./scripts/dev/down.ts",
    "dev:distributed": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=workspace-src\" tsx ./scripts/dev/start.ts --distributed",
    "dev:ios": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=workspace-src\" tsx ./scripts/dev/start.ts --ios",
    "dev:nix": "nix develop --command pnpm dev",
    "dev:reset": "tsx ./scripts/dev/down.ts --volumes",
    "dev:reset:hard": "tsx ./scripts/dev/down.ts --volumes --rmi-local",
    "dev:sandbox-base:push:docker": "pnpm sandbox-base:build --provider docker --publish-mode push",
    "dev:sandbox-base:push:e2b": "pnpm --filter @mistle/sandbox... build && pnpm sandbox-base:build --provider e2b",
    "dev:sandbox-base:push:tensorlake": "pnpm --filter @mistle/sandbox... build && pnpm sandbox-base:build --provider tensorlake --sandboxd-source local",
    "dev:workspace:distributed": "turbo watch dev dev:schedules @mistle/dev-data-plane-gateway-a#dev @mistle/dev-data-plane-gateway-b#dev --ui=tui --filter=!@mistle/docs --filter=!@mistle/data-plane-gateway --filter=!@mistle/dev-data-plane-gateway-a --filter=!@mistle/dev-data-plane-gateway-b --env-mode=loose",
    "dev:workspace": "turbo watch dev dev:schedules --ui=tui --filter=!@mistle/docs --filter=!@mistle/dev-data-plane-gateway-a --filter=!@mistle/dev-data-plane-gateway-b --env-mode=loose",
    "docs:dev": "nix develop .#docs -c pnpm --filter @mistle/docs dev",
    "emails:preview": "pnpm --filter @mistle/emails preview",
    "format": "oxfmt . && pnpm --filter @mistle/sandboxd format && pnpm --filter @mistle/commit-sign format && pnpm --filter @mistle/mstl-core format && pnpm --filter @mistle/mstl-cli format",
    "format:check": "oxfmt --check . && pnpm --filter @mistle/sandboxd format:check && pnpm --filter @mistle/commit-sign format:check && pnpm --filter @mistle/mstl-core format:check && pnpm --filter @mistle/mstl-cli format:check",
    "lint": "pnpm lint:ts && pnpm lint:rust",
    "lint-staged": "lint-staged",
    "lint:docs": "pnpm --filter @mistle/docs lint",
    "lint:dashboard-preflight": "pnpm --filter @mistle/dashboard file-names:check && pnpm --filter @mistle/dashboard openapi:check",
    "lint:fast": "pnpm lint:dashboard-preflight && pnpm lint:package-exports && pnpm lint:oxlint:fast && pnpm lint:openapi && pnpm lint:docs && pnpm lint:rust",
    "lint:knip": "knip --config knip.jsonc --no-progress --reporter compact",
    "lint:knip:report": "knip --config knip.jsonc --no-progress --reporter compact --no-exit-code",
    "lint:openapi": "pnpm --filter @mistle/control-plane-api openapi:check && pnpm --filter @mistle/data-plane-api openapi:check && pnpm --filter @mistle/control-plane-internal-client openapi:check && pnpm --filter @mistle/data-plane-internal-client openapi:check",
    "lint:package-exports": "tsx ./scripts/dev/check-package-exports.ts",
    "lint:oxlint": "oxlint --type-aware --deny-warnings apps packages tests",
    "lint:oxlint:fast": "oxlint --deny-warnings apps packages tests",
    "lint:rust": "pnpm --filter @mistle/sandboxd lint && pnpm --filter @mistle/commit-sign lint && pnpm --filter @mistle/mstl-core lint && pnpm --filter @mistle/mstl-cli lint",
    "lint:spelling": "typos .",
    "lint:sql": "pnpm --filter @mistle/db lint:sql",
    "lint:ts": "pnpm lint:dashboard-preflight && pnpm lint:package-exports && pnpm lint:oxlint && pnpm lint:openapi && pnpm lint:docs",
    "prepare": "node -e \"const cp = require('child_process'); if (!(process.env.CI || process.env.LEFTHOOK === '0')) { try { cp.execSync('git rev-parse --is-inside-work-tree', { stdio: 'ignore' }); cp.execSync('lefthook install', { stdio: 'inherit' }); } catch {} }\"",
    "release:create-tag": "tsx ./scripts/release/create-tag.ts",
    "release:notes": "tsx ./scripts/release/notes.ts",
    "release:prepare": "tsx ./scripts/release/prepare.ts",
    "release:start": "tsx ./scripts/release/start.ts",
    "release:validate-tag": "tsx ./scripts/release/validate-tag.ts",
    "release:write-notes": "tsx ./scripts/release/write-notes.ts",
    "sandbox-base:build": "NODE_OPTIONS='--conditions workspace-src' tsx ./scripts/sandbox-base/build-provider-image.ts",
    "sandbox-base:inventory:check": "pnpm sandbox-base:inventory:check-spec && tsx ./scripts/sandbox-base/generate-inventory.ts --check",
    "sandbox-base:inventory:check-spec": "tsx ./scripts/sandbox-base/check-inventory-spec.ts",
    "sandbox-base:inventory:update": "pnpm sandbox-base:inventory:check-spec && tsx ./scripts/sandbox-base/generate-inventory.ts --write",
    "storybook": "pnpm --filter @mistle/storybook storybook",
    "storybook:build": "pnpm --filter @mistle/storybook build-storybook",
    "test": "pnpm test:workspace && pnpm test:component",
    "test-harness:prepare-runtime": "tsx ./scripts/test/prepare-test-harness-runtime.ts",
    "test:component": "turbo run test:component --output-logs=errors-only",
    "test:e2e": "pnpm --filter @mistle/tests test:e2e",
    "test:integration": "tsx ./scripts/test/run-integration-vitest.ts",
    "test:integration:all": "pnpm test:integration && pnpm test:integration:rust",
    "test:integration:rust": "pnpm --filter @mistle/sandboxd test:integration",
    "test:property": "turbo run test:property",
    "test:rust": "pnpm --filter @mistle/commit-sign test && pnpm --filter @mistle/sandboxd test && pnpm --filter @mistle/mstl-core test && pnpm --filter @mistle/mstl-cli test && pnpm --filter @mistle/sandboxd test:integration",
    "test:sandbox-base:linux": "docker build --platform ${MISTLE_SANDBOX_BASE_CHECK_PLATFORM:-linux/amd64} --target sandbox-base -t mistle-sandbox-base-check:local -f packages/sandboxd/Dockerfile .",
    "test:system": "pnpm --filter @mistle/tests test:system",
    "test:system:all": "pnpm --filter @mistle/tests test:system:all",
    "test:system:docker": "pnpm --filter @mistle/tests test:system:docker",
    "test:system:e2b": "pnpm --filter @mistle/tests test:system:e2b",
    "test:system:legacy": "pnpm --filter @mistle/tests test:system:legacy",
    "test:system:runtime": "pnpm --filter @mistle/tests test:system:runtime",
    "test:ts": "turbo run test --output-logs=errors-only --filter=!@mistle/sandboxd --filter=!@mistle/commit-sign --filter=!@mistle/mstl-core --filter=!@mistle/mstl-cli && pnpm test:component",
    "test:workspace": "turbo run test --output-logs=errors-only",
    "typecheck": "pnpm typecheck:workspace && pnpm typecheck:scripts",
    "typecheck:rust": "turbo run typecheck --output-logs=errors-only --filter=@mistle/sandboxd --filter=@mistle/commit-sign --filter=@mistle/mstl-core --filter=@mistle/mstl-cli",
    "typecheck:scripts": "tsgo --project ./scripts/tsconfig.json",
    "typecheck:ts": "turbo run typecheck --output-logs=errors-only --filter=!@mistle/sandboxd --filter=!@mistle/commit-sign --filter=!@mistle/mstl-core --filter=!@mistle/mstl-cli && pnpm typecheck:scripts",
    "typecheck:workspace": "turbo run typecheck --output-logs=errors-only",
    "validate:changed": "tsx ./scripts/dev/validate-changed.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^21.0.1",
    "@mistle/test-harness": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/native-preview": "latest",
    "knip": "^6.11.0",
    "lefthook": "^2.1.8",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.22.1",
    "smol-toml": "^1.6.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.20.6",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^25.0.0",
    "pnpm": "11.4.0"
  },
  "packageManager": "pnpm@11.4.0"
}
